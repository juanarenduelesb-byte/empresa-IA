# Copia este archivo a .env y cambia las contraseñas. .env no se sube al repositorio.
VARIOS_ENTORNO=local
POSTGRES_PASSWORD=cambia-esta-contraseña
VARIOS_APP_PASSWORD=cambia-esta-otra
# La aplicación entra con un usuario sin privilegios (sujeto a RLS); las migraciones, con el propietario.
VARIOS_DATABASE_URL=postgresql+psycopg://varios_app:cambia-esta-otra@localhost:5432/varios
VARIOS_DATABASE_URL_ADMIN=postgresql+psycopg://postgres:cambia-esta-contraseña@localhost:5432/varios
